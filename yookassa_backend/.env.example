# Данные из личного кабинета ЮKassa → Настройки → Магазин
YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx

# Куда вернуть клиента после оплаты (должен быть публичный HTTPS)
PUBLIC_BASE_URL=https://your-domain.ru
RETURN_URL=https://your-domain.ru/success

# С какими доменами разрешено обращаться к /api/pay (через запятую)
ALLOWED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru

# НДС для чека 54-ФЗ: 1 = без НДС (УСН/самозанятость уточнить в ЮKassa)
YOOKASSA_VAT_CODE=1
